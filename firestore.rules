rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. meetings Collection
    match /meetings/{meetingId} {
      allow read, write: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // 3. meeting_keys Collection (Zero-Trust Key Vault)
    match /meeting_keys/{meetingId} {
      allow read, write: if isAuthenticated();
    }

    // 4. transcript_revisions Collection
    match /transcript_revisions/{revisionId} {
      allow read, write: if isAuthenticated();
    }

    // 5. speaker_profiles Collection
    match /speaker_profiles/{profileId} {
      allow read, write: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // 6. action_items Collection
    match /action_items/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // 7. calendar_events Collection
    match /calendar_events/{eventId} {
      allow read, write: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // 8. search_history Collection
    match /search_history/{logId} {
      allow read, write: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }
  }
}
